<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared puzzle links (https://bumpity.app/play#p=...) open in the app. Verified by
	     /.well-known/apple-app-site-association on the website. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:bumpity.app</string>
	</array>
</dict>
</plist>
